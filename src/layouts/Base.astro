---
import 'katex/dist/katex.min.css';
import '../styles/fonts.css';
import '../generated/cjk.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = 'vo1dLee3', home = false } = Astro.props;
const introScript = `(function () {
  function skip() { document.documentElement.classList.add("intro-seen"); }
  function navType() {
    var nav = performance.getEntriesByType("navigation")[0];
    return nav && nav.type;
  }
  function fromPost() {
    try {
      if (!document.referrer) return false;
      var url = new URL(document.referrer);
      return url.origin === location.origin && url.pathname.indexOf("/blog/") === 0;
    } catch (e) { return false; }
  }
  var type = navType();
  if (type === "back_forward" || (type !== "reload" && fromPost())) skip();
  window.addEventListener("pageshow", function (ev) {
    if (ev.persisted || navType() === "back_forward") skip();
  });
})();`;
const pageTitle = title ?? 'vo1dLee3';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000" />
    {home && <script is:inline set:html={introScript} />}
  </head>
  <body>
    <main class:list={["page", home && "page-home"]}>
      <slot />
    </main>
  </body>
</html>
