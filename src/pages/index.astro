---
import Base from '../layouts/Base.astro';
import { isoDate } from '../utils/date';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
---

<Base home>
  <p class="memtest" aria-label="MEMORY TEST... OK">
    <span class="crt">
      <span class="crt-beam" aria-hidden="true"></span>
      <span class="memtest-run" data-text="MEMORY TEST... OK">
        <span class="mem-lead">MEMORY TEST...</span>
        <span class="mem-ok">OK</span>
      </span>
    </span>
  </p>
  {
    posts.length === 0 ? (
      <p class="empty">还没有笔记。</p>
    ) : (
      <ol class="index">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
              <span class="index-title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<script is:inline>
  (function () {
    var list = document.querySelector(".index");
    var run = document.querySelector(".memtest-run");
    function warming(el) {
      var t = getComputedStyle(el).transform;
      if (!t || t === "none") return false;
      var m = t.match(/matrix\(([^)]+)\)/);
      if (!m) return true;
      var p = m[1].split(",").map(Number);
      return Math.abs(p[0] - 1) > 0.02 || Math.abs(p[3] - 1) > 0.02;
    }
    function align() {
      if (!list || !run || warming(run)) return;
      var parentEl = list.parentElement;
      var parent = parentEl.getBoundingClientRect();
      var text = run.getBoundingClientRect();
      var ps = getComputedStyle(parentEl);
      var inset = parseFloat(ps.paddingLeft) + parseFloat(ps.borderLeftWidth);
      list.style.width = text.width + "px";
      list.style.maxWidth = "none";
      list.style.marginLeft = (text.left - parent.left - inset) + "px";
      list.style.marginRight = "0";
    }
    align();
    window.addEventListener("resize", align);
    if (document.fonts) document.fonts.ready.then(align);
    if (run) run.addEventListener("animationend", align);
    if (document.documentElement.classList.contains("intro-seen")) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var ok = document.querySelector(".mem-ok");
    if (!list) return;
    var shown = false;
    list.classList.add("index-wait");
    function show() {
      if (shown) return;
      shown = true;
      list.classList.remove("index-wait");
      list.classList.add("index-in");
      align();
    }
    if (ok) ok.addEventListener("animationend", show);
    setTimeout(show, 2600);
  })();
</script>
