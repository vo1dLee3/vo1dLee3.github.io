---
import Base from '../layouts/Base.astro';
import { isoDate } from '../utils/date';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
---

<Base home>
  <p class="memtest" aria-label="MEMORY TEST... OK">
    <span class="crt">
      <span class="crt-beam" aria-hidden="true"></span>
      <span class="memtest-run" data-text="MEMORY TEST... OK">
        <span class="mem-lead">MEMORY TEST...</span>
        <span class="mem-ok">OK</span>
      </span>
    </span>
  </p>
  {
    posts.length === 0 ? (
      <p class="empty">还没有笔记。</p>
    ) : (
      <ol class="index">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <time datetime={isoDate(post.data.date)}>{isoDate(post.data.date)}</time>
              <span class="index-title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Base>

<script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var list = document.querySelector(".index");
    var ok = document.querySelector(".mem-ok");
    if (!list) return;
    var shown = false;
    list.classList.add("index-wait");
    function show() {
      if (shown) return;
      shown = true;
      list.classList.remove("index-wait");
      list.classList.add("index-in");
    }
    if (ok) ok.addEventListener("animationend", show);
    setTimeout(show, 2600);
  })();
</script>
