---
import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../utils/date';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const memory = "MEMORY TEST".split("");
---

<Base home>
  <p class="memtest" aria-label="MEMORY TEST... OK">
    <span class="memtest-run" aria-hidden="true">
      {
        memory.map((ch, i) => (
          <span class="mem-ch" style={`--i:${i}`}>
            {ch}
          </span>
        ))
      }
      <span class="mem-dots">
        <span style="--d:0">.</span>
        <span style="--d:1">.</span>
        <span style="--d:2">.</span>
      </span>
      <span class="mem-ok"> OK</span>
    </span>
  </p>
  {
    posts.length === 0 ? (
      <p class="empty">还没有笔记。</p>
    ) : (
      <ol class="index">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <span class="index-title">{post.data.title}</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
</Base>
