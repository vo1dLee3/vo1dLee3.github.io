---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, isoDate } from '../../utils/date';
import { getPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const extra = post.data as { description?: unknown };
const description = typeof extra.description === 'string' ? extra.description : undefined;
---

<Base title={post.data.title} description={description}>
  <article>
    <h1 class="title">{post.data.title}</h1>
    <p class="post-date">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
